completeness_by_year,
completeness_file
)
cat(
"\n",
"============================================\n",
"COMPLETEZZA DEI DATI\n",
"============================================\n",
sep = ""
)
print(
completeness_by_year,
n = Inf
)
# ----------------------------------------------------------
# Grafico temperatura per tutto il periodo
# ----------------------------------------------------------
if (
any(
!is.na(
daily_complete$temperature_mean
)
)
) {
temperature_plot <- ggplot(
daily_complete,
aes(x = date)
) +
geom_ribbon(
aes(
ymin = temperature_min,
ymax = temperature_max
),
alpha = 0.20,
na.rm = TRUE
) +
geom_line(
aes(
y = temperature_mean
),
linewidth = 0.25,
na.rm = TRUE
) +
labs(
title = paste0(
"Temperature giornaliere — ",
selected_station_name
),
subtitle = paste0(
format(start_date, "%d/%m/%Y"),
" – ",
format(end_date, "%d/%m/%Y")
),
x = NULL,
y = "Temperatura (°C)",
caption = "Fonte: ARPA FVG–OSMER"
) +
theme_bw()
print(temperature_plot)
ggsave(
filename = file.path(
output_directory,
paste0(
"osmer_",
safe_station_name,
"_temperature_intero_periodo.png"
)
),
plot = temperature_plot,
width = 13,
height = 6,
dpi = 300
)
}
# ----------------------------------------------------------
# Grafico precipitazioni per tutto il periodo
# ----------------------------------------------------------
if (
any(
!is.na(
daily_complete$precipitation
)
)
) {
precipitation_plot <- ggplot(
daily_complete,
aes(
x = date,
y = precipitation
)
) +
geom_col(
width = 1,
na.rm = TRUE
) +
labs(
title = paste0(
"Precipitazioni giornaliere — ",
selected_station_name
),
subtitle = paste0(
format(start_date, "%d/%m/%Y"),
" – ",
format(end_date, "%d/%m/%Y")
),
x = NULL,
y = "Precipitazioni (mm)",
caption = "Fonte: ARPA FVG–OSMER"
) +
theme_bw()
print(precipitation_plot)
ggsave(
filename = file.path(
output_directory,
paste0(
"osmer_",
safe_station_name,
"_precipitazioni_intero_periodo.png"
)
),
plot = precipitation_plot,
width = 13,
height = 6,
dpi = 300
)
}
# ----------------------------------------------------------
# Dati allineati per il confronto tra anni
# ----------------------------------------------------------
daily_by_year <- daily_complete |>
mutate(
year = year(date),
month = month(date),
day = day(date)
) |>
filter(
!(month == 2 & day == 29)
) |>
mutate(
reference_date = as.Date(
paste0(
"2001-",
format(
date,
"%m-%d"
)
)
),
day_of_year = yday(reference_date)
)
# ----------------------------------------------------------
# Temperature divise per anno
# ----------------------------------------------------------
if (
any(
!is.na(
daily_by_year$temperature_mean
)
)
) {
temperature_by_year_plot <- ggplot(
daily_by_year,
aes(
x = day_of_year,
y = temperature_mean
)
) +
geom_line(
linewidth = 0.35,
na.rm = TRUE
) +
facet_wrap(
vars(year),
ncol = 2
) +
scale_x_continuous(
breaks = c(
1,
60,
121,
182,
244,
305
),
labels = c(
"Gen",
"Mar",
"Mag",
"Lug",
"Set",
"Nov"
)
) +
labs(
title = paste0(
"Temperatura media giorno per giorno — ",
selected_station_name
),
x = NULL,
y = "Temperatura media (°C)",
caption = "Fonte: ARPA FVG–OSMER"
) +
theme_bw()
print(temperature_by_year_plot)
ggsave(
filename = file.path(
output_directory,
paste0(
"osmer_",
safe_station_name,
"_temperature_per_anno.png"
)
),
plot = temperature_by_year_plot,
width = 13,
height = 15,
dpi = 300
)
}
# ----------------------------------------------------------
# Precipitazioni divise per anno
# ----------------------------------------------------------
if (
any(
!is.na(
daily_by_year$precipitation
)
)
) {
precipitation_by_year_plot <- ggplot(
daily_by_year,
aes(
x = day_of_year,
y = precipitation
)
) +
geom_col(
width = 1,
na.rm = TRUE
) +
facet_wrap(
vars(year),
ncol = 2
) +
scale_x_continuous(
breaks = c(
1,
60,
121,
182,
244,
305
),
labels = c(
"Gen",
"Mar",
"Mag",
"Lug",
"Set",
"Nov"
)
) +
labs(
title = paste0(
"Precipitazioni giorno per giorno — ",
selected_station_name
),
x = NULL,
y = "Precipitazioni (mm)",
caption = "Fonte: ARPA FVG–OSMER"
) +
theme_bw()
print(precipitation_by_year_plot)
ggsave(
filename = file.path(
output_directory,
paste0(
"osmer_",
safe_station_name,
"_precipitazioni_per_anno.png"
)
),
plot = precipitation_by_year_plot,
width = 13,
height = 15,
dpi = 300
)
}
# ----------------------------------------------------------
# Totali annuali delle precipitazioni
# ----------------------------------------------------------
annual_precipitation <- daily_complete |>
mutate(
year = year(date)
) |>
group_by(year) |>
summarise(
precipitation_total_mm = if (
all(is.na(precipitation))
) {
NA_real_
} else {
sum(
precipitation,
na.rm = TRUE
)
},
available_days = sum(
!is.na(precipitation)
),
.groups = "drop"
)
annual_precipitation_file <- file.path(
output_directory,
paste0(
"osmer_",
safe_station_name,
"_precipitazioni_annuali.csv"
)
)
write_csv(
annual_precipitation,
annual_precipitation_file
)
if (
any(
!is.na(
annual_precipitation$precipitation_total_mm
)
)
) {
annual_precipitation_plot <- ggplot(
annual_precipitation,
aes(
x = factor(year),
y = precipitation_total_mm
)
) +
geom_col(
na.rm = TRUE
) +
labs(
title = paste0(
"Precipitazioni totali annuali — ",
selected_station_name
),
x = "Anno",
y = "Precipitazioni (mm)",
caption = "Fonte: ARPA FVG–OSMER"
) +
theme_bw()
print(annual_precipitation_plot)
ggsave(
filename = file.path(
output_directory,
paste0(
"osmer_",
safe_station_name,
"_precipitazioni_annuali.png"
)
),
plot = annual_precipitation_plot,
width = 10,
height = 6,
dpi = 300
)
}
# ----------------------------------------------------------
# Risultato
# ----------------------------------------------------------
cat(
"\n",
"============================================\n",
"DOWNLOAD COMPLETATO\n",
"============================================\n",
"Stazione: ",
selected_station_name,
"\n",
"Periodo: ",
as.character(start_date),
" - ",
as.character(end_date),
"\n",
"Giorni scaricati: ",
nrow(osmer_daily_raw),
"\n\n",
"Elenco stazioni:\n",
station_list_file,
"\n\n",
"Dati originali:\n",
raw_file,
"\n\n",
"Dati giornalieri puliti:\n",
clean_file,
"\n\n",
"Completezza:\n",
completeness_file,
"\n\n",
"Cartella risultati:\n",
normalizePath(
output_directory,
mustWork = FALSE
),
"\n",
"============================================\n",
sep = ""
)
list(
stations = stations,
selected_station = selected_station,
raw = osmer_daily_raw,
daily = daily_complete,
completeness = completeness_by_year,
annual_precipitation = annual_precipitation,
files = list(
station_list = station_list_file,
raw = raw_file,
clean = clean_file,
completeness = completeness_file,
annual_precipitation =
annual_precipitation_file
)
)
}
# ============================================================
# 7. ESEGUI IL DOWNLOAD
# ============================================================
osmer_result <- run_osmer_download()
monthly_results <- vector(
mode = "list",
length = nrow(months_to_download)
)
for (
index in seq_len(
nrow(months_to_download)
)
) {
current_year <-
months_to_download$year_value[[index]]
current_month <-
months_to_download$month_value[[index]]
message(
paste0(
"[",
index,
"/",
nrow(months_to_download),
"] Scarico ",
current_year,
"-",
sprintf("%02d", current_month)
)
)
monthly_results[[index]] <- tryCatch(
{
download_month(
year_value = current_year,
month_value = current_month
)
},
error = function(e) {
warning(
paste0(
"Errore per ",
current_year,
"-",
sprintf("%02d", current_month),
": ",
conditionMessage(e)
)
)
tibble()
}
)
Sys.sleep(download_pause)
}
monthly_results <- lapply(
monthly_results,
function(x) {
if (nrow(x) == 0) {
return(x)
}
x |>
mutate(
station_name = as.character(station_name),
station_value = as.character(station_value),
date = as.Date(date),
across(
-any_of(
c(
"station_name",
"station_value",
"date"
)
),
as.character
)
)
}
)
osmer_daily_raw <- bind_rows(
monthly_results
)
if (nrow(osmer_daily_raw) == 0) {
stop(
paste0(
"Nessun mese ha restituito dati.\n\n",
"Controlla che station_search e station_choice ",
"corrispondano alla stazione desiderata."
)
)
}
