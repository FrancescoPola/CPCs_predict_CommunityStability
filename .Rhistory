summary(m_T_opt_sd)$adj.r.squared,
summary(m_traits_interaction)$adj.r.squared
)
) |>
dplyr::mutate(
variable = factor(
variable,
levels = c("traits_interaction", "sd_T_opt", "T_opt_mean", "CV_perf_null", "CV_perf_actual")
)
)
r2_plot <- ggplot(
r2_df,
aes(x = r_squared, y = variable)
) +
geom_segment(
aes(
x = 0,
xend = r_squared,
yend = variable
),
linewidth = 0.8,
colour = "grey75"
) +
geom_point(
size = 3.2,
colour = "black"
) +
geom_text(
aes(label = sprintf("%.2f", r_squared)),
nudge_x = 0.035,
hjust = 0,
size = 3.4
) +
scale_y_discrete(
labels = c(
"CV_perf_actual" =
expression(
atop(
"Actual CP variability",
log[10](CV(CP[actual]))
)
),
"CV_perf_null" =
expression(
atop(
"Null CP variability",
log[10](CV(CP[null]))
)
),
"T_opt_mean" =
expression(
atop(
"Mean thermal mismatch",
group("|", bar(T)[opt] - bar(T), "|")
)
),
"sd_T_opt" =
expression(
atop(
"Thermal optima spread",
sd(T[opt])
)
),
"traits_interaction" =
expression(
atop(
"Trait interaction model",
group("|", bar(T)[opt] - bar(T), "|") %*% sd(T[opt])
)
)
)
) +
scale_x_continuous(
limits = c(0, 0.85),
breaks = seq(0, 0.8, by = 0.2),
expand = expansion(mult = c(0, 0.03))
) +
labs(
x = expression("Adjusted " * R^2),
y = NULL
) +
theme_bw(base_size = 12) +
theme(
panel.grid.major.y = element_blank(),
panel.grid.minor = element_blank(),
axis.text.y = element_text(
size = 10.5,
colour = "black",
lineheight = 0.9
),
axis.text.x = element_text(colour = "black"),
axis.title.x = element_text(
margin = margin(t = 8)
)
)
