y = Inf,
label = paste0("R² = ", syn_r2_text),
hjust = -0.08,
vjust = 1.35,
size = 4.2
) +
xlab(expression(atop("Performance synchrony", phi[perf]))) +
ylab(expression(atop("Biomass synchrony", phi[biom]))) +
labs(title = "Empirical experiment") +
theme_manuscript(12) +
theme(plot.title = element_text(face = "bold", hjust = 0.5))
