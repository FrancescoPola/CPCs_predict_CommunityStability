#| tbl-cap: "Overview of the two experiments included in this report."
#| tbl-cap-location: bottom
#| echo: false
#| message: false
#| warning: false
format_date_range <- function(dates) {
dates <- as.Date(dates)
paste0(
format(min(dates, na.rm = TRUE), "%d %b %Y"),
" to ",
format(max(dates, na.rm = TRUE), "%d %b %Y")
)
}
format_duration <- function(dates) {
dates <- as.Date(dates)
paste0(
as.integer(max(dates, na.rm = TRUE) - min(dates, na.rm = TRUE)) + 1,
" days"
)
}
experiment_overview <- tibble(
Experiment = c(
"Thermal performance curve experiment",
"Community experiment"
),
Duration = c(
paste0(format_duration(TPC_timeseries_raw$date)),
paste0(format_duration(ts_df_raw$date))
),
`Sampling days` = c(
n_distinct(TPC_timeseries_raw$day),
n_distinct(ts_df_raw$day)
),
`Total samples` = c(
format(nrow(TPC_timeseries_raw), big.mark = ","),
format(nrow(ts_df_raw |> select(sample_ID, day) |> distinct()), big.mark = ",")
),
`Outcome / purpose` = c(
"Estimate species thermal performance curves and intrinsic growth rates across temperature.",
"Test whether community performance variability predicts community biomass variability under fluctuating temperatures."
)
)
knitr::kable(
experiment_overview,
align = c("l", "l", "r", "r", "l"),
table.attr = 'class="table table-striped table-hover table-sm"'
)
